# Copy to presentation-studio/.env. Never commit real keys.
# The process environment wins over this file.

# auto | deepseek | openai | libretranslate | mymemory | off
# auto uses DeepSeek, then OpenAI, then LibreTranslate, then public MyMemory.
INTERPRET_PROVIDER=auto

# Optional higher MyMemory quota. The text you speak is sent to that service
# when it is the active translator.
# MYMEMORY_EMAIL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# English speech is MiniMax. Same key and host as the agos `speak` tool / MiniMax client.
# China token plan: https://api.minimaxi.com
# International:    https://api.minimax.io
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_TTS_MODEL=speech-2.8-hd
# Built-in voice from the speak tool. Replace with a voice id you already cloned.
MINIMAX_VOICE_ID=female-shaonv
# Optional sample (mp3/wav). Also set MINIMAX_VOICE_ID to a new id (letter, then 7+ letters or digits).
# The studio uploads it once to /v1/files/upload and /v1/voice_clone, then speaks with that id.
# MINIMAX_CLONE_AUDIO=
# If ~/Projects/dsh-vision/speech.py exists, the studio calls it instead:
#   python3 speech.py speak TEXT --out wav --provider minimax --voice $MINIMAX_VOICE_ID
# DSH_CN_VISION_DIR=

HOST=127.0.0.1
PORT=4173
