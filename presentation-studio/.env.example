# Copy to presentation-studio/.env. Never commit real keys.
# The process environment wins over this file.

# auto | deepseek | openai | libretranslate | mymemory | off
# auto uses DeepSeek, then OpenAI, then LibreTranslate, then public MyMemory.
INTERPRET_PROVIDER=auto

# Optional higher MyMemory quota. The text you speak is sent to that service
# when it is the active translator.
# MYMEMORY_EMAIL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# auto | espeak | openai | browser
# auto uses espeak-ng when the binary exists, else OpenAI speech if a key is set.
TTS_PROVIDER=auto
ESPEAK_BIN=espeak-ng
ESPEAK_VOICE=en-us

HOST=127.0.0.1
PORT=4173
