# Copy to presentation-studio/.env. Never commit real keys.
# The process environment wins over this file.

# auto | qwen-minimax | doubao | minimax | libretranslate | mymemory | off
# auto: Qwen qwen3.8-max translates, MiniMax-M3 rewrites that English, then MiniMax speaks.
# If Qwen has no key or the call fails: Doubao doubao-seed-evolving, then MiniMax-M3 alone.
# Keys are read from the environment, this file, then ~/.config/cc-model-secrets.env.
# Do not paste real keys here. A blank value does not override the secrets file.
INTERPRET_PROVIDER=auto

# Optional higher MyMemory quota. The text you speak is sent to that service
# only when no Qwen, Doubao, or MiniMax key is available.
# MYMEMORY_EMAIL=

LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Qwen Token Plan. agos provider qwen, model qwen3.8-max.
# Leave the host unset to use ~/.dsh/settings.yaml when that file names this key,
# otherwise https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# China Token Plan: https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# QWEN_TOKEN_PLAN_API_KEY=
# QWEN_API_HOST=
# QWEN_CHAT_MODEL=qwen3.8-max

# Doubao fallback. agos provider doubao, model doubao-seed-evolving.
# Default host https://ark.cn-beijing.volces.com/api/v3
# ARK_API_KEY=
# DOUBAO_API_HOST=
# DOUBAO_CHAT_MODEL=doubao-seed-evolving

# MiniMax speaks the English and, on the primary path, rewrites Qwen's draft.
# The same key is the MiniMax-M3-only fallback when Qwen and Doubao are unavailable.
# China token plan: https://api.minimaxi.com
# International:    https://api.minimax.io
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com
# Text model agos already routes as minimax-cn. Override only if you need another MiniMax chat id.
# MINIMAX_CHAT_MODEL=MiniMax-M3
MINIMAX_TTS_MODEL=speech-2.8-hd
# Built-in voice from the speak tool. Replace with a voice id you already cloned.
MINIMAX_VOICE_ID=female-shaonv
# Optional sample (mp3, m4a, or wav). Also set MINIMAX_VOICE_ID to a new id.
# The studio uploads it once at startup via /v1/files/upload and /v1/voice_clone.
# If that voice id already exists, speech uses it anyway.
# MINIMAX_CLONE_AUDIO=
# speech.py is not used when MINIMAX_API_KEY is set. Without a key, an installed
# script is called as: python3 speech.py speak TEXT --out wav --provider minimax --voice ID
# (--clone is MiMo-only and is not passed.)
# DSH_CN_VISION_DIR=

HOST=127.0.0.1
PORT=4173
