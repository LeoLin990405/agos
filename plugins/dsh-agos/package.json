{
  "name": "@dsh-local/agos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgOS-lite:会话无关的 OS 级控制台 —— 侧栏底部入口(sidebar.footer.action)+ 全帧浮层面板(shell.overlay),面板声明 agos.section 子槽供各插件贡献 section(机器/会话总览/…)。0 shell patch,纯插件。",
  "scripts": { "test": "node --test test/*.test.mjs" },
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-locale"]
    },
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "files": ["lib", "cordis.patch.yml"]
}
