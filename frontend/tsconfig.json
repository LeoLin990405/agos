{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@deepseek-ai/dsh-brand": ["./src/contract/shims/brand.ts"],
      "@deepseek-ai/dsh-llm": ["./src/contract/shims/llm.ts"],
      "@deepseek-ai/dsh-llm/brand": ["./src/contract/shims/llm-brand.ts"],
      "@deepseek-ai/dsh-llm/types": ["./src/contract/shims/llm-types.ts"],
      "@deepseek-ai/dsh-session/types": ["./src/contract/shims/session-types.ts"],
      "@deepseek-ai/dsh-session-projection/types": ["./src/contract/shims/session-projection-types.ts"],
      "@deepseek-ai/dsh-attachment": ["./src/contract/shims/attachment.ts"],
      "@deepseek-ai/dsh-jobs/brand": ["./src/contract/shims/jobs-brand.ts"],
      "@deepseek-ai/dsh-tools/presentation": ["./src/contract/shims/tools-presentation.ts"],
      "@deepseek-ai/dsh-user-approval/types": ["./src/contract/shims/user-approval-types.ts"],
      "@deepseek-ai/dsh-user-questions/types": ["./src/contract/shims/user-questions-types.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "vite.config.ts"]
}
